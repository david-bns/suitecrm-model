# Docker values for suitecrm-model. Copy to .docker/.env and run:
#   docker compose --env-file .docker/.env up -d
# (without --env-file, the defaults written in docker-compose.yml apply)

PROJECT_NAME=suitecrm-model
PROJECT_HOST=suitecrm-model.localhost
PLATFORM_NETWORK=docker-proxy_proxy
# Traefik container name, reached from PHP when it calls its own public URL
PROXY_HOST=traefik

UID=1000
GID=1000

DB_IMAGE=mariadb:10.11.9
DB_NAME=suitecrm
DB_USER=suitecrm
DB_PASSWORD=suitecrm
DB_ROOT_PASSWORD=root
# Host port to reach MariaDB from a local client (bound to 127.0.0.1 only)
DB_HOST_PORT=33061
